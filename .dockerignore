# .dockerignore — Hotel Intelligence Platform
# Prevents large / sensitive files from being sent to the Docker build context.

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# Jupyter / IPython
.ipynb_checkpoints/
notebooks/

# Raw data (only processed data is needed at runtime)
data/raw/

# Git
.git/
.gitignore

# IDE / OS
.idea/
.vscode/
*.DS_Store
Thumbs.db

# Environment files with secrets
.env

# Test artefacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Reports and presentations
reports/
presentations/

# GitHub Actions
.github/

# README / docs (not needed in image)
*.md
